# Requires Node 25+ for the bundled local SQLite database.
PORT=5173
PK_DATA_DIR=.data
# OpenAI-compatible chat completions endpoint. No requests until configured and submitted.
PK_AI_URL=
PK_AI_KEY=
PK_AI_MODEL=
# Enable only behind a correctly configured HTTPS reverse proxy.
PK_SECURE_COOKIE=0
# Set to 1 only behind a local proxy that overwrites X-Real-IP.
PK_TRUST_PROXY=0

# Aliyun OSS: all five fields required; leave blank to use local file storage.
PK_OSS_BUCKET=
PK_OSS_ENDPOINT=
PK_OSS_REGION=
PK_OSS_PREFIX=paperknow/
PK_OSS_ACCESS_KEY_ID=
PK_OSS_ACCESS_KEY_SECRET=

# Codex SDK research tasks (uses the configured model through its Responses endpoint).
PK_AGENT_ENABLED=0

# 公共 Claude Agent 执行层；与上面的旧科研助手开关独立。
# 默认关闭，建议在管理后台保存启用配置（保存后以加密配置版本为准）。
# 仅现有百炼 compatible-mode 地址会自动推导其 Anthropic 入口；其他渠道须显式填写。
PK_AGENT_RUNTIME_ENABLED=0
PK_AGENT_BASE_URL=
PK_AGENT_API_KEY=
PK_AGENT_MODEL=
# 32 字节随机密钥的 Base64；为空时复用服务器已有支付配置加密密钥。
PK_AGENT_CONFIG_KEY=
PK_AGENT_MAX_TURNS=6
PK_AGENT_TIMEOUT_MS=180000
PK_AGENT_MAX_OUTPUT_TOKENS=4096
PK_AGENT_MAX_COST_USD=0.5

# Email / phone authentication. Generate a unique random 32+ byte secret per app.
# Both registration and password recovery require a verified code.
PK_AUTH_CODE_SECRET=
# Combined email and SMS send attempts per rolling 24 hours for PaperKnow.
PK_AUTH_DAILY_SEND_LIMIT=100
# Aliyun DirectMail SMTP (sender must be authorized by the mail provider).
PK_EMAIL_SMTP_HOST=smtpdm.aliyun.com
PK_EMAIL_SMTP_PORT=465
PK_EMAIL_SMTP_SECURE=1
PK_EMAIL_SMTP_USER=
PK_EMAIL_SMTP_PASSWORD=
PK_EMAIL_FROM=
# Aliyun SMS: use an approved sign and verification-code template.
PK_SMS_ACCESS_KEY_ID=
PK_SMS_ACCESS_KEY_SECRET=
PK_SMS_SIGN_NAME=
PK_SMS_TEMPLATE_CODE=
PK_SMS_CODE_PARAM=code

# Designated owner email. Admin access is granted ONLY after email code verification.
PK_OWNER_EMAIL=

# Payment configuration encryption only; merchant parameters are managed in /admin.html#payments.
# Required: standard base64 encoding of exactly 32 cryptographically random bytes (44 chars, one trailing =).
# Keep this key stable and back it up securely with the payment database. No automatic key rotation/migration.
# Leave blank to keep payment configuration storage unavailable. Purchases require a ready channel and active product.
# Never commit a real key, merchant private key, API v3 key, or payment-provider public key to this template.
PK_PAYMENT_CONFIG_KEY=

# Production uploads must use OSS; legacy database originals remain readable.
PK_REQUIRE_OSS=0
