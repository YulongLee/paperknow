[Unit]
Description=PaperKnow immutable code release retention

[Service]
Type=oneshot
Group=paperknow
ExecStart=/usr/bin/python3 -I /opt/paperknow/bin/retention.py --apply
Nice=15
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=256M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RuntimeDirectory=paperknow-ops
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ReadWritePaths=/opt/paperknow /run/paperknow-ops
